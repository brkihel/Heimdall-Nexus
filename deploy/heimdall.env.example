# Copy to /etc/heimdall-nexus/heimdall.env and edit for the target server.
# Systemd units for the panel and data collectors should load this file with
# EnvironmentFile=/etc/heimdall-nexus/heimdall.env.

# Checkout and application roots
HEIMDALL_ROOT=/opt/heimdall-nexus
HEIMDALL_SITE_DIR=/var/lib/heimdall-nexus/site
HEIMDALL_DATA_DIR=/var/lib/heimdall-nexus/dados
HEIMDALL_VALHEIM_DIR=/srv/valheim
HEIMDALL_WEB_DIR=/srv/heimdall-web
HEIMDALL_STATE_DIR=/var/lib/heimdall-nexus
HEIMDALL_PANEL_STATE_DIR=/var/lib/heimdall-panel
HEIMDALL_PANEL_SWAP_DIR=/var/lib/heimdall-panel/troca

# Runtime identity and world
HEIMDALL_WEB_USER=www-data
HEIMDALL_WORLD_NAME=Dedicated
HEIMDALL_SERVER_NAME=Valheim
HEIMDALL_SERVER_ADDRESS=play.example.org
HEIMDALL_SERVER_IP=
HEIMDALL_SERVER_PORT=2456
HEIMDALL_TIMEZONE=America/Sao_Paulo
HEIMDALL_PANEL_COOKIE_SECURE=true

# Public live-data files
HEIMDALL_STATUS_FILE=/srv/heimdall-web/api/status.json
HEIMDALL_SAGA_FILE=/srv/heimdall-web/api/saga.json
HEIMDALL_LOCATIONS_FILE=/srv/heimdall-web/mapa/locais.json
HEIMDALL_MODS_LOCK=/srv/valheim/current/mods.lock.json

# Optional overrides for non-standard Valheim layouts
# HEIMDALL_SERVER_ENV=/srv/valheim/server.env
# HEIMDALL_WORLD_DIR=/srv/valheim/saves/worlds_local/Dedicated
# HEIMDALL_CHARACTERS_DIR=/srv/valheim/saves/characters_local
# HEIMDALL_BEPINEX_PLUGINS=/srv/valheim/current/BepInEx/plugins
# HEIMDALL_STATUS_RESTART_CFG=/srv/valheim/config/BepInEx/org.tristan.serverrestart.cfg
# HEIMDALL_STATUS_ZWS_CFG=/srv/valheim/config/BepInEx/ZenDragon.ZenWorldSettings.cfg
# HEIMDALL_STATUS_MRD_CFG=/srv/valheim/config/BepInEx/genesisproj.mrdaynight.cfg
# HEIMDALL_STATUS_SEASON_CFG=/srv/valheim/config/BepInEx/RustyMods.Seasonality.cfg
# HEIMDALL_STATUS_STACKS_CFG=/srv/valheim/config/BepInEx/Genesis.zzzGenesisItemStacks.cfg
# HEIMDALL_SAGA_CACHE=/var/lib/heimdall-nexus/pericias-mod.json
# HEIMDALL_EXTERNAL_ATLAS_DIR=/path/to/private/map-export
# Legacy exports under /srv/*-web/mapa are discovered by matching the world UID.

# Panel runtime paths. Keep the socket identical for panel and executor.
HEIMDALL_PANEL_SOCKET=/run/heimdall-panel/executor.sock
HEIMDALL_GAME_SERVICE=heimdall-valheim
HEIMDALL_PANEL_AUDIT_FILE=/var/log/heimdall-panel/auditoria.jsonl
HEIMDALL_PANEL_BACKUP_DIR=/var/backups/heimdall-panel
HEIMDALL_WEB_BACKUP_DIR=/var/backups/heimdall-web
HEIMDALL_CHRONICLE_DIR=/var/lib/heimdall-nexus/cronica
HEIMDALL_PROFILES_DIR=/var/lib/heimdall-nexus/perfis
HEIMDALL_MAINTENANCE_LOCK=/run/lock/heimdall-maintenance.lock
HEIMDALL_GAME_SERVICE_FILE=/etc/systemd/system/heimdall-valheim.service

# Panel credentials remain separate from this deployment file.
PAINEL_RAIZ=/jarl
PAINEL_CONFIG=/etc/heimdall-panel/config.json

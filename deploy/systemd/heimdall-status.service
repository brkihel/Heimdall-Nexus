[Unit]
Description=Refresh Heimdall Nexus public server status feed
After=network.target

[Service]
Type=oneshot
EnvironmentFile=/etc/heimdall-nexus/heimdall.env
ExecStart=/usr/bin/python3 ${HEIMDALL_ROOT}/site/web/heimdall-status.py
User=root
Group=www-data
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@WEB_ROOT@/api @STATE_ROOT@

[Unit]
Description=Heimdall Nexus administration panel
After=network.target heimdall-executor.service
Wants=heimdall-executor.service

[Service]
Type=simple
User=@PANEL_OS_USER@
Group=@PANEL_OS_USER@
EnvironmentFile=/etc/heimdall-nexus/heimdall.env
WorkingDirectory=@ROOT@/servicos/painel
ExecStart=@ROOT@/servicos/painel/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8791 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/heimdall-panel @PANEL_SWAP_DIR@

[Install]
WantedBy=multi-user.target

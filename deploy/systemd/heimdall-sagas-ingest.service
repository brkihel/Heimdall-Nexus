[Unit]
Description=Import optional Heimdall Sagas game data

[Service]
Type=oneshot
User=@PANEL_OS_USER@
Group=@PANEL_OS_USER@
SupplementaryGroups=heimdall-sagas
UMask=0077
EnvironmentFile=/etc/heimdall-nexus/heimdall.env
WorkingDirectory=@ROOT@/servicos/painel
ExecStart=/usr/bin/python3 @ROOT@/servicos/painel/ingest-sagas.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/heimdall-nexus/sagas

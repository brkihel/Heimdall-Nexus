[Unit]
Description=Heimdall Nexus privileged task executor
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/heimdall-nexus/heimdall.env
ExecStart=/usr/bin/python3 @ROOT@/servicos/painel/executor.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=heimdall-panel
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
